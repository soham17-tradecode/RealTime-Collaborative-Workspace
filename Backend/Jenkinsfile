pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
            }
        }

        stage('Build') {
            steps {
                dir('Backend') {
                    bat 'gradlew.bat clean build -x test'
                }
            }
        }

        stage('Test') {
            steps {
                dir('Backend') {
                    withCredentials([
                        string(
                            credentialsId: 'postgres-test-password',
                            variable: 'TEST_DB_PASSWORD'
                        )
                    ]) {
                        bat '''
                            set SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5433/RealApp
                            set SPRING_DATASOURCE_USERNAME=postgres
                            set SPRING_DATASOURCE_PASSWORD=%TEST_DB_PASSWORD%
                            set SPRING_DATA_REDIS_HOST=127.0.0.1
                            set SPRING_DATA_REDIS_PORT=6380

                            gradlew.bat test --stacktrace
                        '''
                    }
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir('Backend') {
                    bat 'docker build -t realtime-backend:latest .'
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('Backend') {
                    bat 'docker compose --env-file C:\\ProgramData\\Jenkins\\realtime.env up -d'
                }
            }
        }

       stage('Health Check') {
           steps {
               bat '''
                   powershell -NoProfile -Command "$maxAttempts=12; for ($i=1; $i -le $maxAttempts; $i++) { try { $result = curl.exe --noproxy '*' --silent --show-error --fail http://127.0.0.1:8080/actuator/health; Write-Host $result; $health = $result | ConvertFrom-Json; if ($health.status -eq 'UP') { Write-Host 'Application is healthy'; exit 0 } } catch { Write-Host ('Waiting for application... attempt ' + $i + '/' + $maxAttempts) }; Start-Sleep -Seconds 5 }; Write-Host 'Application health check failed'; exit 1"
               '''
           }
       }
    }

    post {
        success {
            echo 'BUILD SUCCESSFUL'
        }

        failure {
            echo 'BUILD FAILED'
        }
    }
}


//webhook test